# ターミナル設定（cmux / Ghostty 共用）
# cmux は libghostty ベースのため、同じ設定ファイルを使用
# https://ghostty.org/docs/config

# フォント設定
font-family = "Ricty Diminished"
font-size = 11
font-thicken = true

# Molokai カラースキーム (iTerm2から変換)
background = #121212
foreground = #d0d0d0
cursor-color = #bbbbbb
selection-background = #b4d5ff
selection-foreground = #000000

# ANSIパレット
palette = 0=#121212
palette = 1=#fa2573
palette = 2=#97e123
palette = 3=#dfd460
palette = 4=#0f7fcf
palette = 5=#8700ff
palette = 6=#42a7cf
palette = 7=#bbbbbb
palette = 8=#555555
palette = 9=#f5669c
palette = 10=#b0e05e
palette = 11=#fef26c
palette = 12=#00afff
palette = 13=#af87ff
palette = 14=#50cdfe
palette = 15=#ffffff

# ウィンドウ設定
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.9

# タブ管理設定
window-save-state = always

# macOS固有設定
macos-option-as-alt = true

# 選択範囲を自動でクリップボードにコピー
copy-on-select = clipboard

# 長いLLM出力やビルドログ向けにスクロールバックを増やす（例: 256MB）
scrollback-limit = 268435456

# キーバインド設定
# Alt + 左右をtmux用に解放
keybind = alt+left=unbind
keybind = alt+right=unbind

# Command + 左右で単語移動
keybind = super+left=text:\x1bb
keybind = super+right=text:\x1bf

# タブ切り替え（Cmd + 数字）
keybind = super+1=goto_tab:1
keybind = super+2=goto_tab:2
keybind = super+3=goto_tab:3
keybind = super+4=goto_tab:4
keybind = super+5=goto_tab:5

# SSH先での互換性のためTERMをxterm-256colorに設定
term = xterm-256color

# =============================================
# cmux / スプリットペイン設定
# ※ libghostty 1.2.0以降のバグで未反映（upstream修正待ち）
#   https://github.com/ghostty-org/ghostty/discussions/8732
# =============================================

# 非アクティブなペインの透過度（0.0=完全透明 〜 1.0=不透明）
unfocused-split-opacity = 0.5

# 非アクティブなペインの背景色（透過時に見える下地の色）
unfocused-split-fill = #1a1a1a

# ペイン間の境界線の色
split-divider-color = #97e123
