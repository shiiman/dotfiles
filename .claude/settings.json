{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'curl.*\\s*\\|\\s*sh|wget.*\\s*\\|\\s*sh|curl.*\\s*\\|\\s*bash|wget.*\\s*\\|\\s*bash'; then echo '⛔ リモートスクリプト実行は禁止されています' >&2; exit 2; fi"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(bash:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(env:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git mv:*)",
      "Bash(git remote:*)",
      "Bash(git rm:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git status:*)",
      "Bash(git tag:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(less:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(pwd:*)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(shellcheck:*)",
      "Bash(sort:*)",
      "Bash(source:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(xargs:*)",
      "Edit(~/dotfiles/.*)",
      "Skill(*)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(apt:*)",
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(chmod -R:*)",
      "Bash(chown:*)",
      "Bash(crontab:*)",
      "Bash(dd:*)",
      "Bash(defaults:*)",
      "Bash(eval:*)",
      "Bash(fdisk:*)",
      "Bash(ftp:*)",
      "Bash(git branch -D:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git rebase:*)",
      "Bash(git reflog:*)",
      "Bash(git reset:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash drop:*)",
      "Bash(iptables:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(launchctl:*)",
      "Bash(mkfs:*)",
      "Bash(mount:*)",
      "Bash(nc:*)",
      "Bash(netcat:*)",
      "Bash(nmap:*)",
      "Bash(osascript:*)",
      "Bash(passwd:*)",
      "Bash(pkill:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -rf:*)",
      "Bash(rsync:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(ssh:*)",
      "Bash(sudo:*)",
      "Bash(systemctl:*)",
      "Bash(ufw:*)",
      "Bash(umount:*)",
      "Bash(useradd:*)",
      "Bash(userdel:*)",
      "Bash(visudo:*)",
      "Bash(yum:*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.netrc)",
      "Edit(**/.npmrc)",
      "Edit(**/credentials*)",
      "Edit(**/id_*)",
      "Edit(**/secrets)",
      "Edit(**/secrets.*)",
      "Edit(**/.ssh/*)",
      "Edit(*_ed25519)",
      "Edit(*_rsa)",
      "Edit(*.key)",
      "Edit(*.pem)",
      "Edit(*.pfx)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/credentials*)",
      "Read(**/secrets)",
      "Read(**/secrets.*)",
      "Read(*_ed25519)",
      "Read(*_rsa)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(*.pfx)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.gitconfig)",
      "Write(**/.netrc)",
      "Write(**/.npmrc)",
      "Write(**/.ssh/*)",
      "Write(**/credentials*)",
      "Write(**/id_*)",
      "Write(**/secrets)",
      "Write(**/secrets.*)",
      "Write(*_ed25519)",
      "Write(*_rsa)",
      "Write(*.key)",
      "Write(*.pem)",
      "Write(*.pfx)"
    ]
  }
}
