# Codex CLI 設定テンプレート
#
# このファイルが追跡対象。実ファイルは ~/.codex/config.toml で、
# ai_setup.sh が「実ファイルが無ければこのテンプレートからコピー」する。
#
# なぜ実ファイルを追跡しないか:
#   Codex CLI は起動時・操作時に以下のセクションを自動で追記・更新する。
#   これらはマシン固有の絶対パスや作業中プロジェクト名を含むため、
#   追跡すると公開リポジトリへ流出し、作業ツリーも常に dirty になる。
#     [projects."<絶対パス>"]        trust_level
#     [hooks.state."<絶対パス>:..."] enabled / trusted_hash
#     [marketplaces.<name>]          last_revision / last_updated
#     [notice.model_migrations]
#     [tui.model_availability_nux]
#
# 設定を変更して dotfiles に反映したいとき:
#   ~/.codex/config.toml を編集したうえで、意図した変更のみこのファイルへ転記する。
#   （上記の自動生成セクションは転記しない）

#:schema https://developers.openai.com/codex/config-schema.json

# Codex CLI Configuration
# 公式ドキュメント準拠: https://github.com/openai/codex/blob/main/docs/config.md

# プロジェクト固有の指示（AGENTS.mdを使用するため空）
# instructions = ""

check_for_update_on_startup = true

# =============================================================================
# Model Settings
# =============================================================================

# 使用するモデル（デフォルト: "gpt-5.1-codex-max"）
model = "gpt-5.6-terra"

# モデルプロバイダー（デフォルト: "openai"）
model_provider = "openai"

# 推論の深さ（デフォルト: "medium"）
# 値: "minimal", "low", "medium", "high", "xhigh"
model_reasoning_effort = "xhigh"

# 推論サマリーの出力（デフォルト: "auto"）
# 値: "auto", "concise", "detailed", "none"
model_reasoning_summary = "auto"

# モデルの出力の詳細度（デフォルト: "medium"）
# 値: "low", "medium", "high"
model_verbosity = "medium"

# コンテキストウィンドウサイズ（トークン数）
# model_context_window = 128000

# 推論サマリーを強制有効化（デフォルト: false）
# model_supports_reasoning_summaries = false

# =============================================================================
# Execution Settings
# =============================================================================

# 承認ポリシー（デフォルト: "untrusted"）
# 値:
#   - "untrusted": すべてのアクションに承認が必要
#   - "on-failure": 失敗時のみ承認が必要
#   - "on-request": リクエスト時のみ承認
#   - "never": 承認なしで実行（危険）
approval_policy = "on-request"

# サンドボックスモード（デフォルト: "read-only"）
# 値:
#   - "read-only": ファイルの読み取りのみ
#   - "workspace-write": ワークスペース内への書き込み許可
#   - "danger-full-access": フルアクセス（危険）
personality = "pragmatic"
sandbox_mode = "workspace-write"

# Web検索機能 disabled/cached/live（デフォルト: disabled）
service_tier = "priority"
web_search = "live"

# =============================================================================
# Sandbox Workspace Write Settings
# =============================================================================

[sandbox_workspace_write]
# サンドボックス内のネットワークアクセス許可（デフォルト: false）
network_access = true

# =============================================================================
# Features (機能フラグ)
# =============================================================================

[features]
# 画像表示ツール（デフォルト: true）- 安定版
view_image_tool = true

# スキル機能（デフォルト: false）- 実験的
skills = true

# unified_exec（デフォルト: false）- 実験的
unified_exec = false

auto_review = true
chronicle = false
enable_mcp_apps = true
memories = true
#multi_agent_v2 = true
secret_auth_storage = true
subagents = true
web_search = true
workflows = true

[agents]
max_threads = 6

[agents.default_worker]
config_file = "~/.codex/agents/default_worker.toml"
description = "Default worker agent."

[agents.fast_worker]
config_file = "~/.codex/agents/fast_worker.toml"
description = "Fast scoped implementation agent."

# =============================================================================
# TUI (Terminal User Interface) Settings
# =============================================================================

[tui]
# 通知（デフォルト: true）
notifications = true

# アニメーション（デフォルト: true）
animations = true

# スクロール反転（デフォルト: false）
scroll_invert = false

[history]
# 履歴の永続化（デフォルト: "none"）
# 値: "none", "save-all"
persistence = "save-all"

# =============================================================================
# Display Settings
# =============================================================================

# 推論イベントを非表示化（デフォルト: false）
hide_agent_reasoning = false

# 生チェーンオブソートを表示（デフォルト: false）
show_raw_agent_reasoning = false

# =============================================================================
# File Opener
# =============================================================================

# ファイルを開くエディタ（デフォルト: "vscode"）
# 値: "vscode", "vscode-insiders", "windsurf", "cursor", "none"
file_opener = "cursor"

# =============================================================================
# Project Documentation
# =============================================================================

# AGENTS.mdから読み込む最大バイト数（デフォルト: 32KiB）
project_doc_max_bytes = 32768

[mcp_servers.playwright]
args = ["@playwright/mcp@latest"]
command = "npx"

[mcp_servers.playwright.tools.browser_evaluate]
approval_mode = "approve"

[mcp_servers.playwright.tools.browser_run_code_unsafe]
approval_mode = "approve"

[mcp_servers.context7]
args = ["--yes", "@upstash/context7-mcp@latest"]
command = "npx"

[mcp_servers.multi-agent-mcp]
args = ["--from", "git+https://github.com/shiiman/multi-agent-mcp", "multi-agent-mcp"]
command = "uvx"

[mcp_servers.notebooklm-mcp]
args = ["--from", "git+https://github.com/shiiman/notebooklm-mcp", "notebooklm-mcp"]
command = "uvx"

[mcp_servers.google-genmedia-mcp]
args = ["--from", "git+https://github.com/shiiman/google-genmedia-mcp", "google-genmedia-mcp"]
command = "uvx"

[mcp_servers.notion]
url = "https://mcp.notion.com/mcp"

[plugins."github@openai-curated"]
enabled = true

[plugins."google-drive@openai-curated"]
enabled = true

[plugins."superpowers@superpowers-marketplace"]
enabled = true
