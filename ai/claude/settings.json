{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__multi-agent-mcp__*",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(*)",
      "Write(*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(gh:*)",
      "Bash(claude:*)",
      "Skill(*)",
      "Skill(shiiman-plugin:*)",
      "Skill(shiiman-claude:*)",
      "Skill(shiiman-git:*)",
      "Skill(shiiman-google:*)",
      "Skill(shiiman-slack:*)",
      "Skill(shiiman-docker:*)",
      "Skill(shiiman-go:*)",
      "Skill(shiiman-terraform:*)",
      "Skill(shiiman-claude-code-plugins:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(pip install --break-system-packages:*)",
      "Bash(pip3 install --break-system-packages:*)",
      "Read(**/.ssh/*)",
      "Read(**/credentials*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Edit(**/.ssh/*)",
      "Edit(**/credentials*)",
      "Write(**/.ssh/*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(rm -r:*)",
      "Bash(rm -rf:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)",
      "Bash(claude config:*)",
      "Edit(.env*)",
      "Write(.env*)"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'curl.*\\s*\\|\\s*sh|wget.*\\s*\\|\\s*sh|curl.*\\s*\\|\\s*bash|wget.*\\s*\\|\\s*bash'; then echo '⛔ リモートスクリプト実行は禁止されています' >&2; exit 2; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/ai/claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "shiiman-plugin@shiiman-claude-code-plugins": false,
    "shiiman-claude@shiiman-claude-code-plugins": false,
    "shiiman-google@shiiman-claude-code-plugins": true,
    "shiiman-slack@shiiman-claude-code-plugins": true,
    "shiiman-docker@shiiman-claude-code-plugins": false,
    "shiiman-go@shiiman-claude-code-plugins": false,
    "shiiman-workflow@shiiman-claude-code-plugins": true,
    "shiiman-terraform@shiiman-claude-code-plugins": false,
    "shiiman-git@shiiman-claude-code-plugins": true
  },
  "outputStyle": "Default",
  "language": "Japanese",
  "alwaysThinkingEnabled": false,
  "plansDirectory": "./.claude/plans",
  "pluginMarketplaces": [
    "shiiman/claude-code-plugins"
  ]
}
