{
  "alwaysThinkingEnabled": false,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "nextjs@sumzap-claude-code-plugins": false,
    "notion@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "shiiman-claude@shiiman-claude-code-plugins": true,
    "shiiman-common@shiiman-claude-code-plugins": true,
    "shiiman-git@shiiman-claude-code-plugins": true,
    "shiiman-github@shiiman-claude-code-plugins": true,
    "shiiman-go@shiiman-claude-code-plugins": true,
    "shiiman-google@shiiman-claude-code-plugins": true,
    "shiiman-slack@shiiman-claude-code-plugins": true,
    "shiiman-terraform@shiiman-claude-code-plugins": true,
    "shiiman-workflow@shiiman-claude-code-plugins": true,
    "superpowers@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "repo": "obra/superpowers-marketplace",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'curl.*\\s*\\|\\s*sh|wget.*\\s*\\|\\s*sh|curl.*\\s*\\|\\s*bash|wget.*\\s*\\|\\s*bash'; then echo '⛔ リモートスクリプト実行は禁止されています' >&2; exit 2; fi",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/ai/claude/scripts/plugin-update.sh &",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ -x \"$HOME/.ai-usage/bin/ai-usage\" ] && \"$HOME/.ai-usage/bin/ai-usage\" collect --source claude || true",
            "type": "command"
          }
        ],
        "id": "ai-usage-collector"
      },
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "[ -n \"$SUPERSET_HOME_DIR\" ] && [ -x \"$SUPERSET_HOME_DIR/hooks/notify.sh\" ] && SUPERSET_AGENT_ID=claude \"$SUPERSET_HOME_DIR/hooks/notify.sh\" || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "language": "Japanese",
  "outputStyle": "Default",
  "permissions": {
    "allow": [
      "mcp__multi-agent-mcp__*",
      "mcp__notebooklm-mcp__*",
      "mcp__google-genmedia-mcp__*",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(*)",
      "Write(*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(gh:*)",
      "Bash(claude:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go list:*)",
      "Bash(go env:*)",
      "Bash(go doc:*)",
      "Bash(go version)",
      "Bash(make go-test-unit)",
      "Bash(make lint-go)",
      "Bash(make lint-yaml)",
      "Bash(make lint-all)",
      "Bash(docker logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Skill(*)",
      "Skill(shiiman-claude:*)",
      "Skill(shiiman-git:*)",
      "Skill(shiiman-github:*)",
      "Skill(shiiman-common:*)",
      "Skill(shiiman-workflow:*)",
      "Skill(shiiman-google:*)",
      "Skill(shiiman-go:*)",
      "Skill(shiiman-terraform:*)",
      "Skill(shiiman-slack:*)",
      "Skill(shiiman-claude-code-plugins:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(rm -r:*)",
      "Bash(rm -rf:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)",
      "Bash(claude config:*)",
      "Edit(.env*)",
      "Write(.env*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(pip install --break-system-packages:*)",
      "Bash(pip3 install --break-system-packages:*)",
      "Read(**/.ssh/*)",
      "Read(**/credentials*)",
      "Read(*.key)",
      "Read(*.pem)",
      "Edit(**/.ssh/*)",
      "Edit(**/credentials*)",
      "Write(**/.ssh/*)"
    ]
  },
  "plansDirectory": "./.claude/plans",
  "pluginMarketplaces": [
    "shiiman/claude-code-plugins"
  ],
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/dotfiles/ai/claude/scripts/statusline.sh",
    "type": "command"
  },
  "teammateMode": "tmux",
  "model": "opus[1m]"
}
