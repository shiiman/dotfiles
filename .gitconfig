[core]
excludesfile = ~/.gitignore_global
quotepath = false
editor = vim
[difftool "sourcetree"]
cmd = opendiff \"$LOCAL\" \"$REMOTE\"
path =
[mergetool "sourcetree"]
cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
trustExitCode = true
[user]
name = shiiman
email = hsnonsense5@gmail.com
[alias]
st = status
co = checkout
br = branch
ci = commit
[color]
ui = auto
diff = auto
status = auto
branch = auto
[http]
sslVerify = true
postBuffer = 524288000
[pull]
rebase = false
[init]
defaultBranch = main
