[core]
	excludesfile = ~/.gitignore_global
	quotepath = false
	editor = vim

[user]
	name = shiiman
	email = hsnonsense5@gmail.com

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	algorithm = histogram

[merge]
	conflictstyle = diff3

[rebase]
	autoStash = true

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	sw = switch
	df = diff
	lg = log --oneline --graph --decorate -10
	unstage = reset HEAD --
	wt = worktree
	wtl = worktree list
	wta = worktree add
	wtr = worktree remove

[extensions]
	worktreeConfig = true

[color]
	ui = auto

[http]
	sslVerify = true
[credential]
	helper = osxkeychain

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
